# Pipeline configuration. Copy to .env and edit; .env is not version-controlled.
#
#   cp .env.example .env
#
# Paths are relative to the working directory, which `python -m src` expects
# to be the repository root. Real environment variables override anything set
# here, so CI can inject values without editing the file.

# Inputs. All are required.
RAW_PERMITS=data/raw/geojson/Nashville_Building_Permit_Applications.geojson
RAW_CLINICS=data/raw/geojson/Public_Health_Clinics.geojson
RAW_DISTRICTS=data/raw/geojson/TN_Congressional_Districts.geojson
RAW_DISTRICTS_CSV=data/raw/csv/TN_Congressional_Districts.csv

# Outputs. All are required; parent directories are created as needed.
PROCESSED_PERMITS=data/processed/geojson/Nashville_Building_Permit_Applications.geojson
PROCESSED_DISTRICTS_CSV=data/processed/csv/TN_Congressional_Districts.csv
REPORTS_MAP=reports/figures/nashville_map.html

# Maximum permit features written to the processed file and drawn on the map.
# Optional; defaults to 100.
PERMIT_LIMIT=100

# Keep only permits whose property equals this value. Both are optional;
# setting only one leaves filtering off.
PERMIT_FILTER_PROPERTY=
PERMIT_FILTER_VALUE=
